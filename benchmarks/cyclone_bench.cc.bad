#include "benchmarks/common.h"
#include "benchmarks/process.h"

#include <benchmark/benchmark.h>
#include <dds/dds.h>

#include <cstdlib>
#include <cstring>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>

namespace {

#pragma pack(push, 1)
struct BenchMsg {
  uint64_t seq;
  uint64_t send_ns;
  // Flexible tail; actual published size is set via loan/write size semantics.
  // For plain write we embed a fixed max and only write `size` bytes via CDR?
  // Cyclone topic types are IDL-ish; for opaque bytes use a sequence or bytes.
};
#pragma pack(pop)

// Opaque blob as a bounded sequence of octets — keeps serialization simple.
struct Blob {
  uint32_t size;
  uint8_t *data;
};

static const dds_topic_descriptor_t *BlobDescriptor() {
  // Use Cyclone's built-in Bytes type via DDS_XTypes or a simple topic with
  // dds_create_topic_arbitrary / raw. Easiest portable path: publish a fixed
  // IDL-less type using DDS_BuiltinTopicBlob isn't available — instead use
  // a char array topic via dds_create_topic with a generated descriptor.
  //
  // Practical approach for this bench: treat payload as `DDS_DATA_REPRESENTATION`
  // free topic using `dds_create_topic` with type "BenchBlob" defined inline
  // through the C++ API would be easier — for C, use a fixed-size array type.
  return nullptr;
}

// Fixed max payload; we only care about first `size` bytes for the benchmark.
static constexpr size_t kMaxPayload = 256 * 1024;

struct FixedBlob {
  uint64_t seq;
  uint64_t send_ns;
  uint32_t len;
  uint8_t bytes[kMaxPayload];
};

// Minimal topic descriptor for FixedBlob (manually matching Cyclone's expectations
// is painful). Use the DDS C++ API instead via a separate translation unit...
// Simpler: use `dds_write` with a topic created from IDL compiled offline.
//
// For a dependency-light bench we use Cyclone's `dds_create_topic` with
// `DDS_BuiltinTopicByte` — not a thing.
//
// Fall back: encode as DDS string? No.
//
// Use cyclonedds-cxx if available. Checking — we have @cyclonedds-cxx.
// Switch this file to C++ API with a simple POD and TopicTraits, OR use
// ddsc with a hand-written topic descriptor.
//
// Hand-rolled ddsi topic for opaque bytes (CommonCyclone pattern for tests):

}  // namespace

// Use a simple approach: topic type is just an array of uint8 with size in qos
// — actually the standard pattern in cyclone examples is IDL.
// We'll use dds_writecdr / loaned samples for SHM with a typedef.

#include <dds/ddsc/dds_public_impl.h>

// Simplest reliable path used by many benches: create topic with
// `dds_create_topic` and type name, using `dds_topic_descriptor` generated for:
//
// struct BenchSample {
//   unsigned long long seq;
//   unsigned long long send_ns;
//   sequence<octet, 262144> payload;
// };
//
// Without idlc in the build graph easily, publish a fixed struct with max
// bytes and set History; the wire still carries the full struct size which
// is OK for latency comparison across sizes if we vary a `used` field and
// accept that DDS may still allocate the full type size.
//
// Varying Arg size with a max-sized struct measures allocate/copy of the
// full type — bad. Better: use `dds_loan_sample` + memcpy of Arg size when
// SHM available; for UDP use writecdr with a serialized blob.
//
// Practical compromise for v1: use cyclonedds C API with a topic of
// `uint8_t data[N]` where N is compile-time max, and create separate
// benchmarks per size class OR use unbounded sequence via CDR serializer.
//
// Going with: one FixedBlob max size, but only write `offsetof + len` via
// `dds_writecdr` constructing CDR manually is error-prone.
//
// **Decision:** use the C++ API from cyclonedds-cxx with a simple type.

#error "replaced by cyclone_bench.cpp using C API bytes topic"
